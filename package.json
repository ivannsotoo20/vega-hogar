{
  "name": "vega-hogar",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema centralizado + agente comercial IA para Vega Hogar Inmobiliaria — proyecto formativo Fyzon",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
