// =============================================================================
// GRUPO J — Pipeline, followups, labels, calendar, voz, mock (port SETTER, F4)
// =============================================================================
// Estos modelos usan campos ESCALARES para las FK (incl. tenantId): la integridad
// referencial vive en el SQL (REFERENCES en migrations/011-013). Las @relation de
// navegación Prisma se añaden por módulo cuando el panel las consuma (F5+); el
// motor consume estas tablas vía supabase-js, no Prisma.

model PipelineRun {
  id                  BigInt    @id @default(autoincrement())
  tenantId            BigInt    @map("tenant_id")
  conversationId      BigInt?   @map("conversation_id")
  correlationId       String    @unique @map("correlation_id") @db.Uuid
  startedAt           DateTime  @default(now()) @map("started_at") @db.Timestamptz
  endedAt             DateTime? @map("ended_at") @db.Timestamptz
  durationMs          Int?      @map("duration_ms")
  generatorModel      String?   @map("generator_model")
  generatorTokensIn   Int?      @map("generator_tokens_in")
  generatorTokensOut  Int?      @map("generator_tokens_out")
  generatorCostUsd    Decimal?  @map("generator_cost_usd") @db.Decimal(10, 6)
  judgeModel          String?   @map("judge_model")
  judgeTokensIn       Int?      @map("judge_tokens_in")
  judgeTokensOut      Int?      @map("judge_tokens_out")
  judgeCostUsd        Decimal?  @map("judge_cost_usd") @db.Decimal(10, 6)
  judgeDecision       String?   @map("judge_decision")
  splitterModel       String?   @map("splitter_model")
  splitterTokensIn    Int?      @map("splitter_tokens_in")
  splitterTokensOut   Int?      @map("splitter_tokens_out")
  splitterCostUsd     Decimal?  @map("splitter_cost_usd") @db.Decimal(10, 6)
  splitterParts       Int?      @map("splitter_parts")
  validatorViolations Json?     @map("validator_violations") @db.JsonB
  totalCostUsd        Decimal?  @map("total_cost_usd") @db.Decimal(10, 6)
  totalTokensIn       Int?      @map("total_tokens_in")
  totalTokensOut      Int?      @map("total_tokens_out")
  outcome             String    @default("in_progress")
  errorMessage        String?   @map("error_message")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, startedAt(sort: Desc)])
  @@index([conversationId])
  @@map("pipeline_runs")
}

model PipelineEvent {
  id             BigInt   @id @default(autoincrement())
