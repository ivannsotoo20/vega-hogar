# =============================================================================
# Vega Hogar — variables de entorno
# =============================================================================
# Copia este fichero a .env.local y rellena los valores reales. .env.local es
# gitignored. Las variables están agrupadas por fase del roadmap (ver
# docs/sops/fase-NN-*.md) — solo se rellenan cuando entra la fase correspondiente.
# =============================================================================


# -----------------------------------------------------------------------------
# Fase 0 — runtime base
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3010
LOG_LEVEL=info


# -----------------------------------------------------------------------------
# Fase 0 — Supabase (provisionado en sub-paso 0.9)
# -----------------------------------------------------------------------------
# 5 vars desde Project Settings → API y Database
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=

# Mirror para el panel (browser-safe). NUNCA poner service_role aquí.
# ⚠ Next.js NO lee este .env.local de la raíz: copia estas 2 vars también a
#   apps/panel/.env.local (ver ONBOARDING.md §3b).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# -----------------------------------------------------------------------------
# Fase 0 — Cache / queue
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379


# -----------------------------------------------------------------------------
# Fase 0 — URLs públicas (panel ↔ motor)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PANEL_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
MOTOR_INTERNAL_URL=http://localhost:3010
# Si la dejas rellena debe tener >=16 chars (si no, el motor hace fail-fast).
INTERNAL_STATS_TOKEN=
# URL pública del panel (links que genera el motor). Sobrescribe con TU dominio.
PANEL_PUBLIC_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Fase 10 — Cron del motor (debounce-tick → pipeline)
# -----------------------------------------------------------------------------
# Sin esto el motor ingiere mensajes pero NO los procesa. Ponlo a true en local
# para el golden path y en producción. (Gated OFF por defecto por seguridad.)
MOTOR_CRON_ENABLED=true


# -----------------------------------------------------------------------------
# Fase 6 — Anthropic Claude (agente IA)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=


# -----------------------------------------------------------------------------
# Fase 6 — Encriptación de credenciales en BD (AES-256-GCM)
# -----------------------------------------------------------------------------
# Generar con: openssl rand -hex 32  (32 bytes hex = 64 chars)
CREDENTIALS_ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# Fase 5 — WhatsApp (YCloud BSP + driver mock)
# -----------------------------------------------------------------------------
# WHATSAPP_PROVIDER: ycloud (real) | mock (simulador del panel para alumnos)
WHATSAPP_PROVIDER=mock
YCLOUD_API_BASE=https://api.ycloud.com
YCLOUD_API_KEY=
# Modos: disabled | warn | enforce. Producción debe estar en enforce.
YCLOUD_WEBHOOK_VERIFY_MODE=warn


# -----------------------------------------------------------------------------
# Fase 8 — Voz (Zadarma + ElevenLabs + STT)
# -----------------------------------------------------------------------------
ZADARMA_API_KEY=
ZADARMA_API_SECRET=
ZADARMA_SIP_USER=

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Provider STT (decisión en Fase 8): deepgram | whisper-realtime | gladia
DEEPGRAM_API_KEY=


# -----------------------------------------------------------------------------
# Fase 12 — Composio (Meta Marketing API)
# -----------------------------------------------------------------------------
# Patrón validado en fyzon-rus Día 3. Plan Composio Free suficiente.
COMPOSIO_API_KEY=

# Meta App custom (white-label en consent screen)
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=


# -----------------------------------------------------------------------------
# Fase 11 — Lead form webhook (form "Vende con nosotros" público)
# -----------------------------------------------------------------------------
# Modos: disabled | warn | enforce
LEAD_FORM_VERIFY_MODE=warn


# -----------------------------------------------------------------------------
# Fase 14 — Observabilidad (decisión Fase 14 si se contrata Sentry)
# -----------------------------------------------------------------------------
# SENTRY_DSN=
